{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.endlessnet.ru/frontend-runtime-config/v2/schema.json",
  "title": "EndlessNet frontend runtime configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "management_api_base_path", "control_plane_url", "site_url", "admin_url", "admin_root"],
  "properties": {
    "schema_version": { "const": 2 },
    "management_api_base_path": { "const": "/api/v1" },
    "control_plane_url": { "type": "string", "format": "uri", "pattern": "^https://" },
    "site_url": { "type": "string", "format": "uri", "pattern": "^https://" },
    "admin_url": { "type": "string", "format": "uri", "pattern": "^https://" },
    "admin_root": { "type": "string", "pattern": "^/", "default": "/" }
  }
}
